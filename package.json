{
  "name": "soleilcode",
  "version": "0.5.0",
  "description": "Free-first, local-first AI coding agent powered by SoleilRelay.",
  "homepage": "https://github.com/Xsoleils/SoleilCode#readme",
  "bugs": {
    "url": "https://github.com/Xsoleils/SoleilCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xsoleils/SoleilCode.git"
  },
  "type": "module",
  "bin": {
    "soleil": "./bin/soleil.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node bin/soleil.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "check": "npm run build && npm test",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "llm",
    "cli",
    "typescript",
    "multilingual",
    "ollama",
    "free-ai",
    "openai-compatible"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "playwright-core": "^1.62.0"
  }
}
